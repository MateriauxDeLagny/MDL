# Envoi des formulaires (devis, contact) via une boîte mail OVH @materiauxdelagny.com.
# Sans ces variables, les emails sont affichés en console en développement
# et le formulaire renvoie une erreur en production.
SMTP_USER=contact@materiauxdelagny.com
SMTP_PASSWORD=mot-de-passe-de-la-boite
